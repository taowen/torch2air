// Generated by models.quantized_qwen3.export. Do not edit.
//
// Stage: {{ stage_name }}
// Source aten targets: {{ aten_targets | join(", ") }}
// Weight prefix: {{ weight_prefix }}
// Q4_K packed rows are gathered on the host before this stage.
// Q4_K block f16 d/dmin are passed as f32 side input until AIE f16 scalar
// conversion is validated; q4 nibbles and per-subblock scales decode here.
// This is pre-AIR tiled MLIR: scf/memref/arith first, then air-opt lowers it.

{% macro byte_at(prefix, name, byte_offset) -%}
      %{{ prefix }}_{{ name }}_word = memref.load %{{ prefix }}_packed_l1[%idx0, %idx{{ byte_offset // 4 }}] : memref<1x36xi32, 2>
      %{{ prefix }}_{{ name }}_shifted = arith.shrui %{{ prefix }}_{{ name }}_word, %i32_{{ (byte_offset % 4) * 8 }} : i32
      %{{ prefix }}_{{ name }} = arith.andi %{{ prefix }}_{{ name }}_shifted, %i32_255 : i32
{%- endmacro %}

{% macro emit_q4k_tile(prefix) -%}
      %{{ prefix }}_packed_col = arith.muli %tile_j, %idx36 : index
      %{{ prefix }}_out_col = arith.muli %tile_j, %idx256 : index
      %{{ prefix }}_packed_tile = memref.subview %packed_rows[%tile_i, %{{ prefix }}_packed_col] [1, 36] [1, 1]
          : memref<{{ sequence_length }}x{{ row_words }}xi32> to memref<1x36xi32, strided<[{{ row_words }}, 1], offset: ?>>
      %{{ prefix }}_scale_tile = memref.subview %block_f16_scales[%tile_i, %tile_j, %idx0] [1, 1, 2] [1, 1, 1]
          : memref<{{ sequence_length }}x{{ blocks_per_row }}x2xf32> to memref<1x1x2xf32, strided<[{{ blocks_per_row * 2 }}, 2, 1], offset: ?>>
      %{{ prefix }}_out_tile = memref.subview %output[%tile_i, %{{ prefix }}_out_col] [1, 256] [1, 1]
          : memref<{{ sequence_length }}x{{ hidden_size }}xf32> to memref<1x256xf32, strided<[{{ hidden_size }}, 1], offset: ?>>

      %{{ prefix }}_packed_l1 = memref.alloc() : memref<1x36xi32, 2>
      %{{ prefix }}_scale_l1 = memref.alloc() : memref<1x1x2xf32, 2>
      %{{ prefix }}_out_l1 = memref.alloc() : memref<1x256xf32, 2>

      memref.copy %{{ prefix }}_packed_tile, %{{ prefix }}_packed_l1
          : memref<1x36xi32, strided<[{{ row_words }}, 1], offset: ?>> to memref<1x36xi32, 2>
      memref.copy %{{ prefix }}_scale_tile, %{{ prefix }}_scale_l1
          : memref<1x1x2xf32, strided<[{{ blocks_per_row * 2 }}, 2, 1], offset: ?>> to memref<1x1x2xf32, 2>

      %{{ prefix }}_d = memref.load %{{ prefix }}_scale_l1[%idx0, %idx0, %idx0] : memref<1x1x2xf32, 2>
      %{{ prefix }}_dmin = memref.load %{{ prefix }}_scale_l1[%idx0, %idx0, %idx1] : memref<1x1x2xf32, 2>

      {% for subblock in range(8) %}
      {% if subblock < 4 %}
      {{ byte_at(prefix, "s" ~ subblock ~ "_scale_byte", 4 + subblock) }}
      {{ byte_at(prefix, "s" ~ subblock ~ "_min_byte", 8 + subblock) }}
      %{{ prefix }}_s{{ subblock }}_scale = arith.andi %{{ prefix }}_s{{ subblock }}_scale_byte, %i32_63 : i32
      %{{ prefix }}_s{{ subblock }}_min = arith.andi %{{ prefix }}_s{{ subblock }}_min_byte, %i32_63 : i32
      {% else %}
      {{ byte_at(prefix, "s" ~ subblock ~ "_d_byte", subblock) }}
      {{ byte_at(prefix, "s" ~ subblock ~ "_m_byte", 4 + subblock) }}
      {{ byte_at(prefix, "s" ~ subblock ~ "_md_byte", 8 + subblock) }}
      %{{ prefix }}_s{{ subblock }}_scale_lo = arith.andi %{{ prefix }}_s{{ subblock }}_md_byte, %i32_15 : i32
      %{{ prefix }}_s{{ subblock }}_scale_hi_0 = arith.shrui %{{ prefix }}_s{{ subblock }}_d_byte, %i32_2 : i32
      %{{ prefix }}_s{{ subblock }}_scale_hi = arith.andi %{{ prefix }}_s{{ subblock }}_scale_hi_0, %i32_48 : i32
      %{{ prefix }}_s{{ subblock }}_scale = arith.ori %{{ prefix }}_s{{ subblock }}_scale_lo, %{{ prefix }}_s{{ subblock }}_scale_hi : i32
      %{{ prefix }}_s{{ subblock }}_min_lo = arith.shrui %{{ prefix }}_s{{ subblock }}_md_byte, %i32_4 : i32
      %{{ prefix }}_s{{ subblock }}_min_hi_0 = arith.shrui %{{ prefix }}_s{{ subblock }}_m_byte, %i32_2 : i32
      %{{ prefix }}_s{{ subblock }}_min_hi = arith.andi %{{ prefix }}_s{{ subblock }}_min_hi_0, %i32_48 : i32
      %{{ prefix }}_s{{ subblock }}_min = arith.ori %{{ prefix }}_s{{ subblock }}_min_lo, %{{ prefix }}_s{{ subblock }}_min_hi : i32
      {% endif %}
      %{{ prefix }}_s{{ subblock }}_scale_f32 = arith.uitofp %{{ prefix }}_s{{ subblock }}_scale : i32 to f32
      %{{ prefix }}_s{{ subblock }}_min_f32 = arith.uitofp %{{ prefix }}_s{{ subblock }}_min : i32 to f32
      %{{ prefix }}_s{{ subblock }}_d_scale = arith.mulf %{{ prefix }}_d, %{{ prefix }}_s{{ subblock }}_scale_f32 : f32
      %{{ prefix }}_s{{ subblock }}_min_scale = arith.mulf %{{ prefix }}_dmin, %{{ prefix }}_s{{ subblock }}_min_f32 : f32
      {% endfor %}

      {% for pair in range(4) %}
      scf.for %{{ prefix }}_q_word_i{{ pair }} = %idx0 to %idx8 step %idx1 {
        %{{ prefix }}_q_word_index{{ pair }} = arith.addi %{{ prefix }}_q_word_i{{ pair }}, %idx{{ 4 + pair * 8 }} : index
        %{{ prefix }}_q_word{{ pair }} = memref.load %{{ prefix }}_packed_l1[%idx0, %{{ prefix }}_q_word_index{{ pair }}] : memref<1x36xi32, 2>
        %{{ prefix }}_q_out_word_base{{ pair }} = arith.muli %{{ prefix }}_q_word_i{{ pair }}, %idx4 : index
        {% for byte in range(4) %}
        %{{ prefix }}_q{{ pair }}_b{{ byte }}_shifted = arith.shrui %{{ prefix }}_q_word{{ pair }}, %i32_{{ byte * 8 }} : i32
        %{{ prefix }}_q{{ pair }}_b{{ byte }}_byte = arith.andi %{{ prefix }}_q{{ pair }}_b{{ byte }}_shifted, %i32_255 : i32
        %{{ prefix }}_q{{ pair }}_b{{ byte }}_lo = arith.andi %{{ prefix }}_q{{ pair }}_b{{ byte }}_byte, %i32_15 : i32
        %{{ prefix }}_q{{ pair }}_b{{ byte }}_hi = arith.shrui %{{ prefix }}_q{{ pair }}_b{{ byte }}_byte, %i32_4 : i32
        %{{ prefix }}_q{{ pair }}_b{{ byte }}_lo_f32 = arith.uitofp %{{ prefix }}_q{{ pair }}_b{{ byte }}_lo : i32 to f32
        %{{ prefix }}_q{{ pair }}_b{{ byte }}_hi_f32 = arith.uitofp %{{ prefix }}_q{{ pair }}_b{{ byte }}_hi : i32 to f32
        %{{ prefix }}_even{{ pair }}_b{{ byte }}_scaled = arith.mulf %{{ prefix }}_s{{ pair * 2 }}_d_scale, %{{ prefix }}_q{{ pair }}_b{{ byte }}_lo_f32 : f32
        %{{ prefix }}_even{{ pair }}_b{{ byte }}_value = arith.subf %{{ prefix }}_even{{ pair }}_b{{ byte }}_scaled, %{{ prefix }}_s{{ pair * 2 }}_min_scale : f32
        %{{ prefix }}_odd{{ pair }}_b{{ byte }}_scaled = arith.mulf %{{ prefix }}_s{{ pair * 2 + 1 }}_d_scale, %{{ prefix }}_q{{ pair }}_b{{ byte }}_hi_f32 : f32
        %{{ prefix }}_odd{{ pair }}_b{{ byte }}_value = arith.subf %{{ prefix }}_odd{{ pair }}_b{{ byte }}_scaled, %{{ prefix }}_s{{ pair * 2 + 1 }}_min_scale : f32
        %{{ prefix }}_out_word_byte{{ pair }}_{{ byte }} = arith.addi %{{ prefix }}_q_out_word_base{{ pair }}, %idx{{ byte }} : index
        %{{ prefix }}_out_even{{ pair }}_{{ byte }} = arith.addi %{{ prefix }}_out_word_byte{{ pair }}_{{ byte }}, %idx{{ pair * 64 }} : index
        %{{ prefix }}_out_odd{{ pair }}_{{ byte }} = arith.addi %{{ prefix }}_out_word_byte{{ pair }}_{{ byte }}, %idx{{ pair * 64 + 32 }} : index
        memref.store %{{ prefix }}_even{{ pair }}_b{{ byte }}_value, %{{ prefix }}_out_l1[%idx0, %{{ prefix }}_out_even{{ pair }}_{{ byte }}] : memref<1x256xf32, 2>
        memref.store %{{ prefix }}_odd{{ pair }}_b{{ byte }}_value, %{{ prefix }}_out_l1[%idx0, %{{ prefix }}_out_odd{{ pair }}_{{ byte }}] : memref<1x256xf32, 2>
        {% endfor %}
      }
      {% endfor %}

      memref.copy %{{ prefix }}_out_l1, %{{ prefix }}_out_tile
          : memref<1x256xf32, 2> to memref<1x256xf32, strided<[{{ hidden_size }}, 1], offset: ?>>

      memref.dealloc %{{ prefix }}_packed_l1 : memref<1x36xi32, 2>
      memref.dealloc %{{ prefix }}_scale_l1 : memref<1x1x2xf32, 2>
      memref.dealloc %{{ prefix }}_out_l1 : memref<1x256xf32, 2>
{%- endmacro %}

module {
  func.func @{{ stage_name }}(
      %packed_rows: memref<{{ sequence_length }}x{{ row_words }}xi32>,
      %block_f16_scales: memref<{{ sequence_length }}x{{ blocks_per_row }}x2xf32>,
      %output: memref<{{ sequence_length }}x{{ hidden_size }}xf32>) {
    {% set index_constants = (range(0, 257) | list + range(0, row_words + 1, 36) | list + range(0, hidden_size + 1, 256) | list + [sequence_length, blocks_per_row, row_words, hidden_size]) | unique | list | sort %}
    {% for value in index_constants %}
    %idx{{ value }} = arith.constant {{ value }} : index
    {% endfor %}
    {% for value in (range(0, 25) | list + [48, 63, 255]) | unique | list | sort %}
    %i32_{{ value }} = arith.constant {{ value }} : i32
    {% endfor %}

    scf.parallel (%launch_i, %launch_j) = (%idx0, %idx0) to (%idx1, %idx1) step (%idx1, %idx1) {
      scf.parallel (%tile_i, %tile_j) = (%idx0, %idx0) to (%idx{{ sequence_length }}, %idx{{ blocks_per_row }}) step (%idx1, %idx1) {
        {{ emit_q4k_tile("tile") }}
        scf.reduce
      }
      scf.reduce
    }

    return
  }
}
